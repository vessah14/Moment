  "narrative": {
    "northStar": "La nuit de fête",
    "overview": "TBF MOMENT is a reception hall at night. The ground is a deep navy night (`night`), layered surfaces are the tables and stages of the room, and colour arrives the way party lights do: electric purple marks what is selected or in focus, and a warm orange-to-pink gradient lights up the one action that moves the event forward. Champagne gold is the jewellery: rare, reserved for premium and VIP moments.\n\nThe interface takes part in the celebration. Buttons are soft pills, cards have generous rounded corners, and small movements (a card that lifts on hover, a logo that draws itself, a \"M\" that traces across the home page) keep it alive. That liveliness never costs clarity: the organiser dashboard stays calm and scannable, and every animation has a `prefers-reduced-motion` fallback. Event sites themselves use a separate theme system (`components/site/themes/`) with their own fonts and palettes; this document covers the platform around them (marketing pages, auth, dashboard).\n\nThe system ships dark by default, with a light theme (`[data-theme=\"light\"]`) that swaps only surface and text tokens; brand colours stay the same.",
    "keyCharacteristics": [
      "Dark night ground with tonal layering; borders, not shadows, separate surfaces.",
      "One warm gradient for the primary action; electric purple for selection, focus and links.",
      "Pill buttons, 16px card corners, 8px field corners.",
      "Plus Jakarta Sans headings over Inter body text, compact sizes (body at 14px).",
      "Festive motion, always with a reduced-motion fallback."
    ],
    "rules": [
      {
        "name": "The One Gradient Rule",
        "body": "The orange-to-pink gradient marks the single primary action of a view (or a highlighted word in a marketing headline). Two gradient buttons side by side means one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Purple Means Here Rule",
        "body": "Electric Purple signals focus, selection and \"you are here\". Don't use it as decoration.",
        "section": "colors"
      },
      {
        "name": "The Gold Is Jewellery Rule",
        "body": "Champagne Gold appears only on premium or VIP elements. It never becomes a general accent.",
        "section": "colors"
      },
      {
        "name": "The Compact Body Rule",
        "body": "Interface text is 14px. Don't inflate dashboard copy to 16px; hierarchy comes from weight and the heading font, not size jumps.",
        "section": "typography"
      },
      {
        "name": "The Tone Before Shadow Rule",
        "body": "Separate surfaces with a lighter tone and a soft border first. Reach for a shadow only when an element floats above the page (dialog, menu, toast) or is the primary action.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the night (`night`) as the ground and lift surfaces with `night-surface` / `night-surface-raised` plus a 1px soft border.",
      "Do give each view one gradient primary action; use solid, outline or ghost buttons for the rest.",
      "Do use `electric-purple` for focus borders, links, selected states and eyebrows.",
      "Do use pill buttons, 16px cards and 8px fields.",
      "Do add life with small, purposeful motion (lift on hover, staged entrances), each with a `prefers-reduced-motion` fallback.",
      "Do define any new colour as a token in `@theme` and its light-theme value under `:root[data-theme=\"light\"]`."
    ],
    "donts": [
      "Don't put champagne gold on ordinary UI; it is for premium and VIP only.",
      "Don't stack shadows on cards at rest; use tone and borders.",
      "Don't use the orange-to-pink gradient as a background for large areas or for more than one action in a view.",
      "Don't hard-code hex colours in components; use the tokens so both themes work.",
      "Don't use `dusk` or `mist` text for anything smaller than 11px or below AA contrast."
    ]
  }
}
