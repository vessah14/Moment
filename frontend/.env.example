VITE_API_URL=http://localhost:5146/api
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Adresse publique du site (URL canoniques, sitemap, images de partage). En production : https://votre-domaine
VITE_SITE_URL=http://localhost:5173

# Cloudinary (facultatif) : nom du compte dont les images sont acceptées sur les sites publics.
# Laisser vide en stockage local.
VITE_CLOUDINARY_CLOUD_NAME=

# Vérification de propriété du domaine (facultatif) : code fourni par Google Search Console
# (méthode « Balise HTML », valeur de content) et par Bing Webmaster Tools.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
