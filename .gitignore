# --- .NET : sorties de compilation (régénérées à chaque build)
bin/
obj/
TestResults/
*.user
*.suo
.vs/

# --- Node : dépendances et builds (frontend/, admin/)
node_modules/
dist/
dist-ssr/
*.local

# --- Journaux
*.log

# --- Fichiers envoyés par les utilisateurs en local (le serveur recrée le dossier ;
#     en production les images vont sur Cloudinary)
backend/src/backend_EventMoment/wwwroot/uploads/

# --- Clés de chiffrement locales (Data Protection) : jamais dans git
backend/src/backend_EventMoment/keys/

# --- Secrets : jamais dans git (dotnet user-secrets / variables d'environnement)
.env
.env.local
*.pfx
*.p12

# --- Éditeurs / OS / outils locaux
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.claude/scheduled_tasks.lock
.claude/settings.local.json

.vercel
.env*
